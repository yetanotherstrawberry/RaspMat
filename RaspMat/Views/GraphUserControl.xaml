<local:UserControlBase
    x:Class="RaspMat.Views.GraphUserControl"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
    xmlns:vm="clr-namespace:RaspMat.ViewModels"
    xmlns:prop="clr-namespace:RaspMat.Properties"
    xmlns:local="clr-namespace:RaspMat.Views"
    xmlns:msagl="http://mlsagl"
    mc:Ignorable="d"
    d:MinHeight="350"
    d:MinWidth="800"
    d:DataContext="{d:DesignInstance vm:GraphUserControlViewModel, IsDesignTimeCreatable=False}"
    d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <GroupBox Header="Vertex">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Name="VertexName" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Click="AddVertex"
                        Content="Add"
                        Margin="5"
                        IsEnabled="{Binding ElementName=VertexName, Path=Text.Length}" />
                    <ComboBox
                        Grid.Column="0"
                        Grid.Row="1"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Name="VertexToRemoveName"
                        ItemsSource="{Binding ElementName=GraphControl, Path=Graph.Nodes}"
                        DisplayMemberPath="Id"
                        SelectedValuePath="Id" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Remove"
                        Click="RemoveVertex"
                        Margin="5"
                        IsEnabled="{Binding ElementName=VertexToRemoveName, Path=Text.Length}" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Edge">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Name="EdgeSource"
                        ItemsSource="{Binding ElementName=GraphControl, Path=Graph.Nodes}"
                        DisplayMemberPath="Id"
                        SelectedValuePath="Id" />
                    <ComboBox
                        Grid.Column="1"
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        Name="EdgeTarget"
                        ItemsSource="{Binding ElementName=GraphControl, Path=Graph.Nodes}"
                        DisplayMemberPath="Id"
                        SelectedValuePath="Id"
                        IsEnabled="{Binding ElementName=EdgeSource, Path=Text.Length}" />
                    <Button
                        Grid.Column="0"
                        Grid.Row="1"
                        Content="Add"
                        HorizontalAlignment="Stretch"
                        Click="AddEdge"
                        Margin="5"
                        IsEnabled="{Binding ElementName=EdgeTarget, Path=Text.Length}" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="1"
                        Content="Remove"
                        HorizontalAlignment="Stretch"
                        Click="RemoveEdge"
                        Margin="5"
                        IsEnabled="{Binding ElementName=EdgeTarget, Path=Text.Length}" />
                </Grid>
            </GroupBox>
        </StackPanel>
        <msagl:AutomaticGraphLayoutControl
            Grid.Row="0"
            Grid.Column="1"
            x:Name="GraphControl">
            <msagl:AutomaticGraphLayoutControl.Resources>
            </msagl:AutomaticGraphLayoutControl.Resources>
        </msagl:AutomaticGraphLayoutControl>
    </Grid>
</local:UserControlBase>
 