<local:UserControlBase
    x:Class="RaspMat.Views.GraphUserControl"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:vm="clr-namespace:RaspMat.ViewModels"
    xmlns:prop="clr-namespace:RaspMat.Properties"
    xmlns:local="clr-namespace:RaspMat.Views"
    mc:Ignorable="d"
    d:MinHeight="350"
    d:MinWidth="800"
    d:DataContext="{d:DesignInstance vm:GraphUserControlViewModel, IsDesignTimeCreatable=False}"
    d:Background="White">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="3*"/>
        </Grid.ColumnDefinitions>
        <StackPanel Grid.Row="0" Grid.Column="0">
            <GroupBox Header="Vertices">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="70" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBox
                        Grid.Column="0"
                        Grid.Row="0"
                        Margin="5"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Name="NewVertexName" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="0"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Add"
                        Command="{Binding AddVertexCommand}"
                        CommandParameter="{Binding Source={x:Reference NewVertexName}, Path=Text}"
                        Padding="2,0,2,0"
                        Margin="5" />
                    <ComboBox
                        Grid.Column="0"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        ItemsSource="{Binding Vertices}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="."
                        Name="SelectedVertexToRemove"
                        Margin="5" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"
                        Content="Remove"
                        Command="{Binding RemoveVertexCommand}"
                        CommandParameter="{Binding Source={x:Reference SelectedVertexToRemove}, Path=SelectedValue}"
                        Padding="2,0,2,0"
                        Margin="5" />
                </Grid>
            </GroupBox>
            <GroupBox Header="Edges">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ComboBox
                        Grid.Column="0"
                        Grid.Row="0"
                        ItemsSource="{Binding Vertices}"
                        SelectedItem="{Binding LeftVertex}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="."
                        Margin="5"
                        HorizontalAlignment="Stretch" />
                    <ComboBox
                        Grid.Column="1"
                        Grid.Row="0"
                        ItemsSource="{Binding Vertices}"
                        SelectedItem="{Binding RightVertex}"
                        DisplayMemberPath="Name"
                        SelectedValuePath="."
                        Margin="5"
                        HorizontalAlignment="Stretch" />
                    <Button
                        Grid.Column="0"
                        Grid.Row="1"
                        Content="Add"
                        HorizontalAlignment="Stretch"
                        Command="{Binding AddEdgeCommand}"
                        Margin="5" />
                    <Button
                        Grid.Column="1"
                        Grid.Row="1"
                        Content="Remove"
                        HorizontalAlignment="Stretch"
                        Command="{Binding RemoveEdgeCommand}"
                        Margin="5" />
                </Grid>
            </GroupBox>
        </StackPanel>
        <Viewbox Grid.Row="0" Grid.Column="1">
            <local:DirectedGraphLayout
                IsEnabled="True"
                Graph="{Binding Graph, Mode=OneWay}"
                LayoutMode="Simple"
                LayoutAlgorithmType="Sugiyama"
                OverlapRemovalAlgorithmType="FSA"
                 />
        </Viewbox>
    </Grid>
</local:UserControlBase>
