<local:DialogWindowBase
             x:Class="RaspMat.Views.InputMatrixDialog"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RaspMat.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prop="clr-namespace:RaspMat.Properties"
             xmlns:local="clr-namespace:RaspMat.Views"
             mc:Ignorable="d"
             Width="400"
             Height="170"
             ResizeMode="NoResize"
             d:DataContext="{d:DesignInstance vm:InputMatrixDialogViewModel, IsDesignTimeCreatable=False}"
             d:Background="White"
             Title="{x:Static prop:Resources.ENTER_MATRIX}"
             IsEnabled="{Binding IsFree}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <ResourceDictionary>
                <ResourceDictionary.MergedDictionaries>
                    <ResourceDictionary Source="pack://application:,,,/RaspMat;component/Resources/Styles.xaml" />
                </ResourceDictionary.MergedDictionaries>

                <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                    <Setter Property="Height" Value="90" />
                </Style>
            </ResourceDictionary>
        </Grid.Resources>
        <TextBox
            AcceptsReturn="True"
            Text="{Binding Input}"
            Grid.Row="0" />
        <StackPanel
            Grid.Row="1">
            <Button
                Content="{x:Static prop:Resources.OK}"
                Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</local:DialogWindowBase>
