<local:DialogWindowBase
             x:Class="RaspMat.Views.InputMatrixDialog"
             x:ClassModifier="internal"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:RaspMat.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:prop="clr-namespace:RaspMat.Properties"
             xmlns:local="clr-namespace:RaspMat.Views"
             mc:Ignorable="d"
             Width="400"
             Height="170"
             ResizeMode="NoResize"
             d:DataContext="{d:DesignInstance vm:InputMatrixDialogViewModel, IsDesignTimeCreatable=False}"
             d:Background="White"
             Title="{x:Static prop:Resources.ENTER_MATRIX}"
             IsEnabled="{Binding IsFree}">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <TextBox
            AcceptsReturn="True"
            Text="{Binding Input}"
            Grid.Row="0" />
        <StackPanel
            Margin="3,4,3,0"
            Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center">
            <Button
                Padding="3"
                Content="{x:Static prop:Resources.OK}"
                Command="{Binding SaveCommand}" />
        </StackPanel>
    </Grid>
</local:DialogWindowBase>
