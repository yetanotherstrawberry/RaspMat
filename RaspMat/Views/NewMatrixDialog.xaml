<local:DialogWindowBase
    x:Class="RaspMat.Views.NewMatrixDialog"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:RaspMat.ViewModels"
    xmlns:c="clr-namespace:RaspMat.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:prop="clr-namespace:RaspMat.Properties"
    xmlns:local="clr-namespace:RaspMat.Views"
    mc:Ignorable="d"
    Width="400"
    Height="170"
    ResizeMode="NoResize"
    d:DataContext="{d:DesignInstance vm:NewMatrixDialogViewModel, IsDesignTimeCreatable=False}"
    d:Background="White"
    Title="{x:Static prop:Resources.ENTER_MATRIX}"
    IsEnabled="{Binding IsFree}">
    <Grid Margin="5">
        <Grid.Resources>
            <ResourceDictionary>
                <c:StringToUshortConverter x:Key="StringToUShortConverter" />
            </ResourceDictionary>
        </Grid.Resources>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0">
                <Label
                    Content="{x:Static prop:Resources.IN_ROWS}"
                    Target="{Binding ElementName=RowsTextBox}" />
                <TextBox
                    Height="25"
                    Text="{Binding Rows, Converter={StaticResource StringToUShortConverter}}"
                    Margin="1"
                    Name="RowsTextBox"
                    PreviewTextInput="TextBox_PreviewTextInput" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <Label
                    Content="{x:Static prop:Resources.IN_COLUMNS}"
                    Target="{Binding ElementName=ColumnsTextBox}" />
                <TextBox
                    Height="25"
                    Text="{Binding Columns, Converter={StaticResource StringToUShortConverter}}"
                    Margin="1"
                    Name="ColumnsTextBox"
                    PreviewTextInput="TextBox_PreviewTextInput" />
            </StackPanel>
        </Grid>
        <StackPanel Grid.Row="1" HorizontalAlignment="Center">
            <StackPanel Orientation="Horizontal">
                <Label
                    Content="{x:Static prop:Resources.FILL}"
                    Target="{Binding ElementName=FillTextBox}" />
                <TextBox
                    Height="25"
                    Text="{Binding Fill}"
                    Name="FillTextBox"
                    Margin="1"
                    PreviewTextInput="TextBox_PreviewTextInput"
                    Width="80" />
            </StackPanel>
            <Button
                Command="{Binding CloseDialogCommand}"
                Content="{x:Static prop:Resources.OK}"
                Margin="5" />
        </StackPanel>
    </Grid>
</local:DialogWindowBase>
